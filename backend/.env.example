# Copy to backend/.env for local development. Never commit the real file.

# Must be EXACTLY the frontend's NEXT_PUBLIC_SUPABASE_URL: the session cookie name comes from
# its host. Do not mix localhost and 127.0.0.1.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=<publishable key from npx supabase status>

# Server only. Needed only by account deletion, admin user deletion and the registration avatar.
SUPABASE_SERVICE_ROLE_KEY=
# Same value as the frontend uses today.
AUTH_RATE_LIMIT_SECRET=

# Shared with the frontend's server (never NEXT_PUBLIC_). At least 32 characters; a
# comma-separated list during rotation. Generate: openssl rand -hex 32
INTERNAL_API_SECRET=

# Public frontend origin, used in auth emails.
SITE_URL=http://localhost:3000
# Comma-separated origins allowed to send writes.
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

TRUST_PROXY_HOPS=1
PORT=4000
